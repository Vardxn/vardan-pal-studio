  "narrative": {
    "northStar": "The Open Bahi-Khata",
    "overview": "The page is a red cloth-bound ledger opened on a desk, with ruled paper pages, hand-written marginalia, violet stamps and a single yellow cord. Set type states facts; a handwriting face annotates them. Depth is physical, never glassy or gradient.",
    "keyCharacteristics": [
      "Red cloth ground, pale ruled paper, blue-black ink.",
      "Two voices: Anek Latin set type and Kalam pen.",
      "Violet stamps are the emphasis device; yellow cord the only bright accent.",
      "Open book spread on desktop; stacked sheets below 1100px.",
      "Reduced-motion respected."
    ],
    "rules": [
      {
        "name": "The Cloth-and-Paper Rule",
        "body": "Text on cloth is cream; text on paper is ink or ruling blue.",
        "section": "colors"
      },
      {
        "name": "The One Cord Rule",
        "body": "Yellow appears as a thread, tape, highlight or focus ring, never as a surface.",
        "section": "colors"
      },
      {
        "name": "The Stamp Is Emphasis Rule",
        "body": "Emphasis is a violet stamp or a cloth-red word, not bold colour blocks.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Set type states facts; Kalam annotates them.",
        "section": "typography"
      },
      {
        "name": "The Uppercase-Is-A-Stamp Rule",
        "body": "Tracked uppercase exists only inside a stamp.",
        "section": "typography"
      },
      {
        "name": "The Paper-On-Cloth Rule",
        "body": "Shadows are soft, long and directionless; no hard offset shadows and no glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep text on a solid paper surface so the ruling shows only in margins and blank space.",
      "Do write annotations in Kalam in ruling blue or margin red, at 1.05rem or larger.",
      "Do use rotation only on physical objects: stamps, photos, thumbnails, signature.",
      "Do keep motion short (0.12 to 0.42s) and honour prefers-reduced-motion.",
      "Do keep 44px minimum targets and a visible focus ring tuned to the surface it sits on."
    ],
    "donts": [
      "Don't use gradients as decoration; the only gradients are the cloth weave, the cord stripe, paper ruling and fold shading.",
      "Don't use hard offset shadows, glassmorphism or glows.",
      "Don't use cord yellow as a button or panel fill.",
      "Don't use the ivory/champagne-gold/charcoal or Cormorant Garamond system of premium.css on this homepage."
    ]
  }
